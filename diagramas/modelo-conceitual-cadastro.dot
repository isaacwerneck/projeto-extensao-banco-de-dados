graph G { graph [rankdir=LR, bgcolor="white", nodesep=.3, ranksep=.6, pad=.15];
node [fontname="Arial", fontsize=13]; edge [fontname="Arial", fontsize=12];
especie [shape=box, label="ESPECIE"];
especie_0 [shape=ellipse, fontsize=11, label=<<U>id_especie</U>>]; especie -- especie_0;
especie_1 [shape=ellipse, fontsize=11, label="nome"]; especie -- especie_1;
especie_2 [shape=ellipse, fontsize=11, label="descricao"]; especie -- especie_2;
raca [shape=box, label="RACA"];
raca_0 [shape=ellipse, fontsize=11, label=<<U>id_raca</U>>]; raca -- raca_0;
raca_1 [shape=ellipse, fontsize=11, label="nome"]; raca -- raca_1;
raca_2 [shape=ellipse, fontsize=11, label="descricao"]; raca -- raca_2;
voluntario [shape=box, label="VOLUNTARIO"];
voluntario_0 [shape=ellipse, fontsize=11, label=<<U>id_voluntario</U>>]; voluntario -- voluntario_0;
voluntario_1 [shape=ellipse, fontsize=11, label="nome"]; voluntario -- voluntario_1;
voluntario_2 [shape=ellipse, fontsize=11, label="cpf"]; voluntario -- voluntario_2;
voluntario_3 [shape=ellipse, fontsize=11, label="telefone"]; voluntario -- voluntario_3;
voluntario_4 [shape=ellipse, fontsize=11, label="email"]; voluntario -- voluntario_4;
voluntario_5 [shape=ellipse, fontsize=11, label="funcao"]; voluntario -- voluntario_5;
voluntario_6 [shape=ellipse, fontsize=11, label="data_entrada"]; voluntario -- voluntario_6;
voluntario_7 [shape=ellipse, fontsize=11, label="situacao"]; voluntario -- voluntario_7;
animal [shape=box, label="ANIMAL"];
animal_0 [shape=ellipse, fontsize=11, label=<<U>id_animal</U>>]; animal -- animal_0;
animal_1 [shape=ellipse, fontsize=11, label="nome"]; animal -- animal_1;
animal_2 [shape=ellipse, fontsize=11, label="sexo"]; animal -- animal_2;
animal_3 [shape=ellipse, fontsize=11, label="data_nascimento_estimada"]; animal -- animal_3;
animal_4 [shape=ellipse, fontsize=11, label="porte"]; animal -- animal_4;
animal_5 [shape=ellipse, fontsize=11, label="cor_pelagem"]; animal -- animal_5;
animal_6 [shape=ellipse, fontsize=11, label="data_resgate"]; animal -- animal_6;
animal_7 [shape=ellipse, fontsize=11, label="local_resgate"]; animal -- animal_7;
animal_8 [shape=ellipse, fontsize=11, label="situacao"]; animal -- animal_8;
animal_9 [shape=ellipse, fontsize=11, label="observacoes"]; animal -- animal_9;
rel0 [shape=diamond, label="classifica", fontsize=11]; especie -- rel0 [label="(0,N)"]; rel0 -- raca [label="(1,1)"];
rel1 [shape=diamond, label="pertence", fontsize=11]; especie -- rel1 [label="(0,N)"]; rel1 -- animal [label="(1,1)"];
rel2 [shape=diamond, label="caracteriza", fontsize=11]; raca -- rel2 [label="(0,N)"]; rel2 -- animal [label="(0,1)"];
rel3 [shape=diamond, label="responsabiliza", fontsize=11]; voluntario -- rel3 [label="(0,N)"]; rel3 -- animal [label="(0,1)"];
}