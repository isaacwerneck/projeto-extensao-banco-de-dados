graph G { graph [rankdir=LR, bgcolor="white", nodesep=.3, ranksep=.6, pad=.15];
node [fontname="Arial", fontsize=13]; edge [fontname="Arial", fontsize=12];
animal [shape=box, label="ANIMAL"];
animal_0 [shape=ellipse, fontsize=11, label=<<U>id_animal</U>>]; animal -- animal_0;
animal_1 [shape=ellipse, fontsize=11, label="nome"]; animal -- animal_1;
animal_2 [shape=ellipse, fontsize=11, label="sexo"]; animal -- animal_2;
animal_3 [shape=ellipse, fontsize=11, label="data_nascimento_estimada"]; animal -- animal_3;
animal_4 [shape=ellipse, fontsize=11, label="porte"]; animal -- animal_4;
animal_5 [shape=ellipse, fontsize=11, label="cor_pelagem"]; animal -- animal_5;
animal_6 [shape=ellipse, fontsize=11, label="data_resgate"]; animal -- animal_6;
animal_7 [shape=ellipse, fontsize=11, label="local_resgate"]; animal -- animal_7;
animal_8 [shape=ellipse, fontsize=11, label="situacao"]; animal -- animal_8;
animal_9 [shape=ellipse, fontsize=11, label="observacoes"]; animal -- animal_9;
adotante [shape=box, label="ADOTANTE"];
adotante_0 [shape=ellipse, fontsize=11, label=<<U>id_adotante</U>>]; adotante -- adotante_0;
adotante_1 [shape=ellipse, fontsize=11, label="nome"]; adotante -- adotante_1;
adotante_2 [shape=ellipse, fontsize=11, label="cpf"]; adotante -- adotante_2;
adotante_3 [shape=ellipse, fontsize=11, label="data_nascimento"]; adotante -- adotante_3;
adotante_4 [shape=ellipse, fontsize=11, label="telefone"]; adotante -- adotante_4;
adotante_5 [shape=ellipse, fontsize=11, label="email"]; adotante -- adotante_5;
adotante_6 [shape=ellipse, fontsize=11, label="endereco"]; adotante -- adotante_6;
adotante_7 [shape=ellipse, fontsize=11, label="cidade"]; adotante -- adotante_7;
adotante_8 [shape=ellipse, fontsize=11, label="data_cadastro"]; adotante -- adotante_8;
adotante_9 [shape=ellipse, fontsize=11, label="situacao"]; adotante -- adotante_9;
adocao [shape=box, label="ADOCAO"];
adocao_0 [shape=ellipse, fontsize=11, label=<<U>id_adocao</U>>]; adocao -- adocao_0;
adocao_1 [shape=ellipse, fontsize=11, label="data_solicitacao"]; adocao -- adocao_1;
adocao_2 [shape=ellipse, fontsize=11, label="data_analise"]; adocao -- adocao_2;
adocao_3 [shape=ellipse, fontsize=11, label="data_adocao"]; adocao -- adocao_3;
adocao_4 [shape=ellipse, fontsize=11, label="situacao"]; adocao -- adocao_4;
adocao_5 [shape=ellipse, fontsize=11, label="observacoes"]; adocao -- adocao_5;
rel6 [shape=diamond, label="participa", fontsize=11]; animal -- rel6 [label="(0,N)"]; rel6 -- adocao [label="(1,1)"];
rel7 [shape=diamond, label="solicita", fontsize=11]; adotante -- rel7 [label="(0,N)"]; rel7 -- adocao [label="(1,1)"];
}