graph G { graph [rankdir=TB, bgcolor="white", nodesep=.3, ranksep=.6, pad=.15];
node [fontname="Arial", fontsize=13]; edge [fontname="Arial", fontsize=12];
animal [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#e5e5e5"><B>animal</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id_animal</TD><TD ALIGN="LEFT">INT *</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_especie</TD><TD ALIGN="LEFT">INT *</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_raca</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_voluntario_responsavel</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">nome</TD><TD ALIGN="LEFT">VARCHAR(80) *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">sexo</TD><TD ALIGN="LEFT">CHAR(1) *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">data_nascimento_estimada</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">porte</TD><TD ALIGN="LEFT">VARCHAR(10) *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">cor_pelagem</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">data_resgate</TD><TD ALIGN="LEFT">DATE *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">local_resgate</TD><TD ALIGN="LEFT">VARCHAR(160) *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">situacao</TD><TD ALIGN="LEFT">VARCHAR(25) *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">observacoes</TD><TD ALIGN="LEFT">VARCHAR(500)</TD></TR></TABLE>>];
veterinario [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#e5e5e5"><B>veterinario</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id_veterinario</TD><TD ALIGN="LEFT">INT *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">nome</TD><TD ALIGN="LEFT">VARCHAR(120) *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">crmv</TD><TD ALIGN="LEFT">VARCHAR(20) * UQ</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">telefone</TD><TD ALIGN="LEFT">VARCHAR(20) *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">clinica</TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR></TABLE>>];
tratamento [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#e5e5e5"><B>tratamento</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id_tratamento</TD><TD ALIGN="LEFT">INT *</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_animal</TD><TD ALIGN="LEFT">INT *</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_veterinario</TD><TD ALIGN="LEFT">INT *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">data_tratamento</TD><TD ALIGN="LEFT">DATE *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT">VARCHAR(80) *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">diagnostico</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">descricao</TD><TD ALIGN="LEFT">VARCHAR(500) *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">valor</TD><TD ALIGN="LEFT">DECIMAL(10,2) *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">data_retorno</TD><TD ALIGN="LEFT">DATE</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">situacao</TD><TD ALIGN="LEFT">VARCHAR(12) *</TD></TR></TABLE>>];
animal -- tratamento [taillabel="1", headlabel="0..N", labeldistance=2];
veterinario -- tratamento [taillabel="1", headlabel="0..N", labeldistance=2];
}