graph G { graph [rankdir=LR, bgcolor="white", nodesep=.3, ranksep=.6, pad=.15];
node [fontname="Arial", fontsize=13]; edge [fontname="Arial", fontsize=12];
animal [shape=box, label="ANIMAL"];
animal_0 [shape=ellipse, fontsize=11, label=<<U>id_animal</U>>]; animal -- animal_0;
animal_1 [shape=ellipse, fontsize=11, label="nome"]; animal -- animal_1;
animal_2 [shape=ellipse, fontsize=11, label="sexo"]; animal -- animal_2;
animal_3 [shape=ellipse, fontsize=11, label="data_nascimento_estimada"]; animal -- animal_3;
animal_4 [shape=ellipse, fontsize=11, label="porte"]; animal -- animal_4;
animal_5 [shape=ellipse, fontsize=11, label="cor_pelagem"]; animal -- animal_5;
animal_6 [shape=ellipse, fontsize=11, label="data_resgate"]; animal -- animal_6;
animal_7 [shape=ellipse, fontsize=11, label="local_resgate"]; animal -- animal_7;
animal_8 [shape=ellipse, fontsize=11, label="situacao"]; animal -- animal_8;
animal_9 [shape=ellipse, fontsize=11, label="observacoes"]; animal -- animal_9;
veterinario [shape=box, label="VETERINARIO"];
veterinario_0 [shape=ellipse, fontsize=11, label=<<U>id_veterinario</U>>]; veterinario -- veterinario_0;
veterinario_1 [shape=ellipse, fontsize=11, label="nome"]; veterinario -- veterinario_1;
veterinario_2 [shape=ellipse, fontsize=11, label="crmv"]; veterinario -- veterinario_2;
veterinario_3 [shape=ellipse, fontsize=11, label="telefone"]; veterinario -- veterinario_3;
veterinario_4 [shape=ellipse, fontsize=11, label="email"]; veterinario -- veterinario_4;
veterinario_5 [shape=ellipse, fontsize=11, label="clinica"]; veterinario -- veterinario_5;
tratamento [shape=box, label="TRATAMENTO"];
tratamento_0 [shape=ellipse, fontsize=11, label=<<U>id_tratamento</U>>]; tratamento -- tratamento_0;
tratamento_1 [shape=ellipse, fontsize=11, label="data_tratamento"]; tratamento -- tratamento_1;
tratamento_2 [shape=ellipse, fontsize=11, label="tipo"]; tratamento -- tratamento_2;
tratamento_3 [shape=ellipse, fontsize=11, label="diagnostico"]; tratamento -- tratamento_3;
tratamento_4 [shape=ellipse, fontsize=11, label="descricao"]; tratamento -- tratamento_4;
tratamento_5 [shape=ellipse, fontsize=11, label="valor"]; tratamento -- tratamento_5;
tratamento_6 [shape=ellipse, fontsize=11, label="data_retorno"]; tratamento -- tratamento_6;
tratamento_7 [shape=ellipse, fontsize=11, label="situacao"]; tratamento -- tratamento_7;
rel4 [shape=diamond, label="recebe", fontsize=11]; animal -- rel4 [label="(0,N)"]; rel4 -- tratamento [label="(1,1)"];
rel5 [shape=diamond, label="realiza", fontsize=11]; veterinario -- rel5 [label="(0,N)"]; rel5 -- tratamento [label="(1,1)"];
}