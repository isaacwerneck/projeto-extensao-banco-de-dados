graph G { graph [rankdir=TB, bgcolor="white", nodesep=.3, ranksep=.6, pad=.15];
node [fontname="Arial", fontsize=13]; edge [fontname="Arial", fontsize=12];
doador [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#e5e5e5"><B>doador</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id_doador</TD><TD ALIGN="LEFT">INT *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">nome</TD><TD ALIGN="LEFT">VARCHAR(140) *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">tipo_pessoa</TD><TD ALIGN="LEFT">CHAR(2) *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">documento</TD><TD ALIGN="LEFT">VARCHAR(14) * UQ</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">telefone</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">cidade</TD><TD ALIGN="LEFT">VARCHAR(80) *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">data_cadastro</TD><TD ALIGN="LEFT">DATE *</TD></TR></TABLE>>];
doacao [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="3" BGCOLOR="#e5e5e5"><B>doacao</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id_doacao</TD><TD ALIGN="LEFT">INT *</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">id_doador</TD><TD ALIGN="LEFT">INT *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">data_doacao</TD><TD ALIGN="LEFT">DATE *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT">VARCHAR(10) *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">descricao</TD><TD ALIGN="LEFT">VARCHAR(255) *</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">valor</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">quantidade</TD><TD ALIGN="LEFT">DECIMAL(10,2)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">unidade</TD><TD ALIGN="LEFT">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">situacao</TD><TD ALIGN="LEFT">VARCHAR(10) *</TD></TR></TABLE>>];
doador -- doacao [taillabel="1", headlabel="0..N", labeldistance=2];
}